<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TufaylMissionPad" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/mission_cream</item>
        <item name="android:navigationBarColor">@color/mission_white</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">@color/mission_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/mission_cream</item>
        <item name="android:windowSplashScreenAnimationDuration">350</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
